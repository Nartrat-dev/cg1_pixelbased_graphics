<Window x:Class="CG_Labor1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CG_Labor1"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1500">
    <Grid>
        <Button Content="Dreieck" HorizontalAlignment="Left" Margin="1094,154,0,0" VerticalAlignment="Top" Height="44" Width="80" Click="Triangle_Click"/>
        <Button Content="Image einlesen" HorizontalAlignment="Left" Margin="1256,154,0,0" VerticalAlignment="Top" Height="44" Width="144" Click="Campus_Click"/>
        <Image x:Name="myImage" Height="697" Margin="342,99,402,0" VerticalAlignment="Top"/>
        <Button Content="RGB Image" HorizontalAlignment="Right" Margin="0,257,266,0" VerticalAlignment="Top" Height="44" Width="143" Click="RGBCheckboxCampus_Click"/>
        <Button Content="RGB Image Inverted" HorizontalAlignment="Right" Margin="0,257,99,0" VerticalAlignment="Top" Height="44" Width="143" Click="RGBCheckboxCampusInverted_Click"/>
        <StackPanel Margin="1416,257,29,618">
            <CheckBox x:Name="Red_Checkbox" Width="415" Content="Red" Checked="Red_Checked" Unchecked="Red_Checked"/>
            <CheckBox x:Name="Green_Checkbox" Width="415" Content="Green" Checked="Blue_Checked" Unchecked="Blue_Checked"/>
            <CheckBox x:Name="Blue_Checkbox" Width="415" Content="Blue" Checked="Green_Checked" Unchecked="Green_Checked"/>
        </StackPanel>
        <Button Content="Image Graustufen" HorizontalAlignment="Right" Margin="0,375,267,0" VerticalAlignment="Top" Height="44" Width="143" Click="GrayscaleImage_Click"/>
        <Button Content="Image Graustufen&#xD;&#xA;Inverted" HorizontalAlignment="Right" Margin="0,375,100,0" VerticalAlignment="Top" Height="44" Width="143" Click="GrayscaleImageInverted_Click"/>
        <Button Content="Image Graustufen&#xD;&#xA;Schwellenwert" HorizontalAlignment="Right" Margin="0,465,266,0" VerticalAlignment="Top" Height="44" Width="144" Click="GrayscaleImageThreshhold_Click"/>
        <Slider x:Name="Sliderino" HorizontalAlignment="Left" Margin="1268,479,0,0" VerticalAlignment="Top" Width="120" Maximum="255" ValueChanged="Slider_ValueChanged"/>
        <Button Content="Image Graustufen&#xA;Gamma" HorizontalAlignment="Right" Margin="0,539,266,0" VerticalAlignment="Top" Height="44" Width="144" Click="Gamma_Click"/>
        <Slider x:Name="SliderinosSohn" HorizontalAlignment="Left" Margin="1268,553,0,0" VerticalAlignment="Top" Width="120" Maximum="255" ValueChanged="Slider_ValueChanged2"/>
        <Button Content="Image Graustufen&#xA;Farbpallete" HorizontalAlignment="Right" Margin="0,613,266,0" VerticalAlignment="Top" Height="44" Width="144" Click="GrayscalePalette_Click"/>
    </Grid>
</Window>
